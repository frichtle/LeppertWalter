rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'frichtle@gmail.com' ||
          request.auth.token.email == 'walter.leppert@aol.com'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins registry
    match /admins/{adminId} {
      allow get: if isAdmin() && isValidId(adminId);
      allow list: if isAdmin();
      allow write: if false;
    }

    // Validation helper for GuestbookEntry
    function isValidGuestbookEntry(data) {
      return data.keys().hasAll(['author', 'location', 'tourName', 'text', 'status', 'entryNumber', 'createdAt']) &&
        data.keys().hasOnly(['author', 'location', 'rating', 'tourName', 'text', 'status', 'entryNumber', 'createdAt']) &&
        data.author is string && data.author.size() >= 1 && data.author.size() <= 100 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 100 &&
        data.tourName is string && data.tourName.size() >= 1 && data.tourName.size() <= 100 &&
        data.text is string && data.text.size() >= 3 && data.text.size() <= 2000 &&
        (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5)) &&
        data.entryNumber is number && data.entryNumber > 0 &&
        data.status in ['pending', 'approved', 'rejected'];
    }

    // Guestbook collection
    match /guestbook_entries/{entryId} {
      allow get: if isValidId(entryId) && (existing().status == 'approved' || isAdmin());
      allow list: if resource.data.status == 'approved' || isAdmin();

      // Visitors can create entries with status 'pending'
      allow create: if isValidId(entryId) &&
        isValidGuestbookEntry(incoming()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time;

      // Only admins can update (e.g. approve or reject status)
      allow update: if isValidId(entryId) &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        incoming().status in ['pending', 'approved', 'rejected'];

      allow delete: if isValidId(entryId) && isAdmin();
    }

    // Validation helper for Inquiry
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'tourId', 'tourTitle', 'status', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'phone', 'tourId', 'tourTitle', 'date', 'groupSize', 'message', 'status', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        data.tourId is string && data.tourId.size() >= 1 && data.tourId.size() <= 50 &&
        data.tourTitle is string && data.tourTitle.size() >= 1 && data.tourTitle.size() <= 150 &&
        (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
        (!('groupSize' in data) || (data.groupSize is string && data.groupSize.size() <= 20)) &&
        (!('message' in data) || (data.message is string && data.message.size() <= 3000)) &&
        data.status in ['new', 'contacted', 'completed'];
    }

    // Inquiries collection
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();

      // Visitors can submit inquiries with status 'new'
      allow create: if isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time;

      // Only admins can update status or delete
      allow update: if isValidId(inquiryId) &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        incoming().status in ['new', 'contacted', 'completed'];

      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // Validation helper for GalleryItem
    function isValidGalleryItem(data) {
      return data.keys().hasAll(['title', 'category', 'imageUrl', 'createdAt']) &&
        data.keys().hasOnly(['title', 'category', 'imageUrl', 'year', 'description', 'createdAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
        data.imageUrl is string && data.imageUrl.size() >= 5 && data.imageUrl.size() <= 500000 &&
        (!('year' in data) || (data.year is string && data.year.size() <= 10)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500));
    }

    // Gallery items collection
    match /gallery_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;

      allow create: if isValidId(itemId) &&
        isAdmin() &&
        isValidGalleryItem(incoming()) &&
        incoming().createdAt == request.time;

      allow update: if isValidId(itemId) &&
        isAdmin() &&
        isValidGalleryItem(incoming());

      allow delete: if isValidId(itemId) && isAdmin();
    }
  }
}
